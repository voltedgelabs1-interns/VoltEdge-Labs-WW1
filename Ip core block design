module spi_top #(parameter DATA_WIDTH = 8, parameter CLK_DIV = 4)(
    input wire clk,
    input wire rst_n,
    input wire start,
    input wire [DATA_WIDTH-1:0] master_tx_data,
    input wire cpol,
    input wire cpha,
    output wire [DATA_WIDTH-1:0] master_rx_data,
    output wire done
);

    // SPI wires
    wire sclk;
    wire mosi;
    wire miso;
    wire cs_n;

    // -------------------------
    // MASTER INSTANCE
    // -------------------------
    spi_master #(.DATA_WIDTH(DATA_WIDTH), .CLK_DIV(CLK_DIV)) master (
        .clk(clk),
        .rst_n(rst_n),
        .start(start),
        .tx_data(master_tx_data),
        .cpol(cpol),
        .cpha(cpha),
        .busy(),
        .done(done),
        .sclk(sclk),
        .mosi(mosi),
        .miso(miso),
        .cs_n(cs_n),
        .rx_data(master_rx_data)
    );

    // -------------------------
    // SLAVE INSTANCE
    // -------------------------
    spi_slave #(.DATA_WIDTH(DATA_WIDTH)) slave (
        .rst_n(rst_n),
        .sclk(sclk),
        .mosi(mosi),
        .miso(miso),
        .cs_n(cs_n),
        .cpol(cpol),
        .cpha(cpha)
    );

endmodule


// ==========================================================
// ===================== SPI MASTER ==========================
// ==========================================================
module spi_master #(parameter DATA_WIDTH = 8, parameter CLK_DIV = 4)(
    input wire clk, rst_n, start,
    input wire [DATA_WIDTH-1:0] tx_data,
    input wire cpol, cpha,
    output reg busy, done,
    output reg sclk, mosi,
    input wire miso,
    output reg cs_n,
    output reg [DATA_WIDTH-1:0] rx_data
);

    reg miso_sync1, miso_sync2;
    always @(posedge clk) begin
        miso_sync1 <= miso;
        miso_sync2 <= miso_sync1;
    end

    reg [$clog2(CLK_DIV)-1:0] clk_cnt;
    reg sclk_int;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            clk_cnt <= 0;
            sclk_int <= 0;
        end else if (busy) begin
            if (clk_cnt == CLK_DIV-1) begin
                clk_cnt <= 0;
                sclk_int <= ~sclk_int;
            end else
                clk_cnt <= clk_cnt + 1;
        end else begin
            sclk_int <= cpol;
            clk_cnt <= 0;
        end
    end

    always @(*) sclk = sclk_int;

    reg sclk_d;
    always @(posedge clk) sclk_d <= sclk_int;

    wire rising  = (sclk_int & ~sclk_d);
    wire falling = (~sclk_int & sclk_d);

    wire sample_edge = (cpha==0) ? (cpol==0 ? rising : falling)
                                : (cpol==0 ? falling : rising);

    wire shift_edge  = (cpha==0) ? (cpol==0 ? falling : rising)
                                : (cpol==0 ? rising : falling);

    localparam IDLE=0, LOAD=1, TRANSFER=2, DONE=3;
    reg [1:0] state;

    reg [DATA_WIDTH-1:0] tx_shift, rx_shift;
    reg [$clog2(DATA_WIDTH):0] bit_cnt;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state<=IDLE; cs_n<=1; busy<=0; done<=0;
            mosi<=0; rx_data<=0; bit_cnt<=0;
        end else begin
            done<=0;

            case(state)
                IDLE: begin
                    cs_n<=1; busy<=0;
                    if(start) state<=LOAD;
                end

                LOAD: begin
                    cs_n<=0; busy<=1;
                    tx_shift<=tx_data; rx_shift<=0; bit_cnt<=0;
                    state<=TRANSFER;
                end

                TRANSFER: begin
                    if(shift_edge) begin
                        mosi <= tx_shift[DATA_WIDTH-1];
                        tx_shift <= {tx_shift[DATA_WIDTH-2:0],1'b0};
                    end

                    if(sample_edge) begin
                        rx_shift <= {rx_shift[DATA_WIDTH-2:0], miso_sync2};
                        if(bit_cnt==DATA_WIDTH-1) state<=DONE;
                        bit_cnt<=bit_cnt+1;
                    end
                end

                DONE: begin
                    cs_n<=1; busy<=0; done<=1;
                    rx_data<=rx_shift;
                    state<=IDLE;
                end
            endcase
        end
    end
endmodule


// ==========================================================
// ===================== SPI SLAVE ===========================
// ==========================================================
module spi_slave #(parameter DATA_WIDTH = 8)(
    input wire rst_n,
    input wire sclk,
    input wire mosi,
    output reg miso,
    input wire cs_n,
    input wire cpol,
    input wire cpha
);

    reg sclk_d;
    always @(posedge sclk or negedge rst_n)
        if (!rst_n) sclk_d <= 0;
        else sclk_d <= sclk;

    wire rising  = (sclk & ~sclk_d);
    wire falling = (~sclk & sclk_d);

    wire sample_edge = (cpha==0) ? (cpol==0 ? rising : falling)
                                : (cpol==0 ? falling : rising);

    wire shift_edge  = (cpha==0) ? (cpol==0 ? falling : rising)
                                : (cpol==0 ? rising : falling);

    reg [DATA_WIDTH-1:0] shift_reg;
    reg [$clog2(DATA_WIDTH):0] bit_cnt;

    always @(posedge sclk or negedge rst_n) begin
        if (!rst_n) begin
            shift_reg <= 0;
            bit_cnt   <= 0;
            miso      <= 0;
        end else if (!cs_n) begin

            if (sample_edge) begin
                shift_reg <= {shift_reg[DATA_WIDTH-2:0], mosi};
                bit_cnt   <= bit_cnt + 1;
            end

            if (shift_edge) begin
                miso <= shift_reg[DATA_WIDTH-1];
            end

        end else begin
            bit_cnt <= 0;
        end
    end

endmodule
