module i2c_master #(
    parameter CLK_DIV = 250  // System Clock / (4 * SCL Frequency)
)(
    input  wire clk,
    input  wire rst_n,

    input  wire start,
    input  wire rw,            // 0 = write, 1 = read
    input  wire [6:0] addr,
    input  wire [7:0] data_in,
    input  wire last_byte,     // control: NACK on last read byte

    output reg  [7:0] data_out,
    output reg  busy,
    output reg  done,
    output reg  ack_error,
    output reg  lost_arbitration,

    inout  wire sda,
    inout  wire scl
);

    // -------------------------
    // State Definitions
    // -------------------------
    localparam IDLE  = 0,
               START = 1,
               ADDR  = 2,
               ACK1  = 3,
               DATA  = 4,
               ACK2  = 5,
               STOP  = 6;

    // -------------------------
    // Phase Definitions
    // -------------------------
    localparam PH_SETUP  = 2'd0; // change SDA while SCL high
    localparam PH_RISE   = 2'd1; // release SCL, wait for scl_in==1
    localparam PH_SAMPLE = 2'd2; // sample SDA while SCL high
    localparam PH_FALL   = 2'd3; // drive SCL low

    // -------------------------
    // Open-Drain & Synchronization
    // -------------------------
    reg sda_drive_low; 
    reg scl_drive_low;
    reg [2:0] sda_sync, scl_sync;

    assign sda = (sda_drive_low) ? 1'b0 : 1'bz;
    assign scl = (scl_drive_low) ? 1'b0 : 1'bz;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            sda_sync <= 3'b111;
            scl_sync <= 3'b111;
        end else begin
            sda_sync <= {sda_sync[1:0], sda};
            scl_sync <= {scl_sync[1:0], scl};
        end
    end
    
    wire sda_in = sda_sync[2];
    wire scl_in = scl_sync[2];

    // -------------------------
    // Timing Generator
    // -------------------------
    reg [15:0] clk_cnt;
    reg [1:0]  phase; 
    wire phase_tick = (clk_cnt >= (CLK_DIV-1));

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            clk_cnt <= 0;
            phase   <= PH_SETUP;
        end else if (busy) begin
            if (phase_tick) begin
                clk_cnt <= 0;
                phase   <= phase + 1;
            end else begin
                clk_cnt <= clk_cnt + 1;
            end
        end else begin
            clk_cnt <= 0;
            phase   <= PH_SETUP;
        end
    end

    // -------------------------
    // Main FSM
    // -------------------------
    reg [2:0] state;
    reg [3:0] bit_cnt;
    reg [7:0] shift_reg;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            state <= IDLE;
            busy <= 0;
            done <= 0;
            ack_error <= 0;
            lost_arbitration <= 0;
            sda_drive_low <= 0;
            scl_drive_low <= 0;
            data_out <= 0;
            bit_cnt <= 0;
        end else begin
            done <= 0;

            case (state)
                IDLE: begin
                    busy <= 0;
                    ack_error <= 0;
                    lost_arbitration <= 0;
                    sda_drive_low <= 0;
                    scl_drive_low <= 0;
                    if (start && sda_in && scl_in) begin
                        busy <= 1;
                        shift_reg <= {addr, rw};
                        state <= START;
                    end
                end

                START: begin
                    if (phase_tick) begin
                        case (phase)
                            PH_SETUP: sda_drive_low <= 1; // SDA low while SCL high
                            PH_FALL:  scl_drive_low <= 1; // drive SCL low
                            PH_FALL:  state <= ADDR; bit_cnt <= 7;
                        endcase
                    end
                end

                ADDR: begin
                    if (phase_tick) begin
                        case (phase)
                            PH_SETUP: begin
                                sda_drive_low <= (shift_reg[bit_cnt] == 1'b0);
                                // arbitration check when sending '1'
                                if (shift_reg[bit_cnt] && (sda_in == 0) && scl_in)
                                    lost_arbitration <= 1;
                            end
                            PH_RISE:  scl_drive_low <= 0; // release SCL
                            PH_SAMPLE: ; // sample not needed here
                            PH_FALL: begin
                                scl_drive_low <= 1;
                                if (bit_cnt == 0) state <= ACK1;
                                else bit_cnt <= bit_cnt - 1;
                            end
                        endcase
                    end
                end

                ACK1: begin
                    if (phase_tick) begin
                        case (phase)
                            PH_SETUP: sda_drive_low <= 0; // release SDA
                            PH_RISE:  scl_drive_low <= 0;
                            PH_SAMPLE: ack_error <= sda_in; // sample ACK
                            PH_FALL: begin
                                scl_drive_low <= 1;
                                shift_reg <= (rw) ? 8'hFF : data_in;
                                bit_cnt <= 7;
                                state <= DATA;
                            end
                        endcase
                    end
                end

                DATA: begin
                    if (phase_tick) begin
                        case (phase)
                            PH_SETUP: begin
                                if (rw) sda_drive_low <= 0; // release for read
                                else begin
                                    sda_drive_low <= (shift_reg[bit_cnt] == 1'b0);
                                    if (shift_reg[bit_cnt] && (sda_in == 0) && scl_in)
                                        lost_arbitration <= 1;
                                end
                            end
                            PH_RISE:  scl_drive_low <= 0;
                            PH_SAMPLE: if (rw) shift_reg[bit_cnt] <= sda_in;
                            PH_FALL: begin
                                scl_drive_low <= 1;
                                if (bit_cnt == 0) state <= ACK2;
                                else bit_cnt <= bit_cnt - 1;
                            end
                        endcase
                    end
                end

                ACK2: begin
                    if (phase_tick) begin
                        case (phase)
                            PH_SETUP: begin
                                if (rw) sda_drive_low <= (!last_byte); // ACK if not last
                                else sda_drive_low <= 0; // release for slave ACK
                            end
                            PH_RISE:  scl_drive_low <= 0;
                            PH_SAMPLE: if (!rw) ack_error <= sda_in;
                            PH_FALL: begin
                                scl_drive_low <= 1;
                                data_out <= shift_reg;
                                state <= STOP;
                            end
                        endcase
                    end
                end

                STOP: begin
                    if (phase_tick) begin
                        case (phase)
                            PH_SETUP: sda_drive_low <= 1; // SDA low
                            PH_RISE:  scl_drive_low <= 0; // release SCL
                            PH_SAMPLE: sda_drive_low <= 0; // release SDA high while SCL high
                            PH_FALL: begin
                                busy <= 0;
                                done <= 1;
                                state <= IDLE;
                            end
                        endcase
                    end
                end
            endcase
        end
    end

endmodule

